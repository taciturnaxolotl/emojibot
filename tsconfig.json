{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noFallthroughCasesInSwitch": true,
		"types": ["bun-types"]
	},
	"include": ["src"]
}
